<?xml version="1.0" encoding="utf-8"?>
<!-- Merge these permissions and intent-filters into android/app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for API & OTP verification -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- SIM slot / carrier detection (Android runtime permission required) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Android 11+ (API 30+) runtime permission to attempt SIM phone number read -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Screenshot gallery access on Android 13+ (API 33+) and legacy API <= 32 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <!-- ShareSheet receiver for copied SMS/receipt text, screenshots, CSV, and JSON -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/json" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>
    </application>
</manifest>
